
<% # Get all jpg and png images from app/assets/images %>
<% images = Dir[Rails.root.join("app/assets/images/*.{jpg,png,jpeg,gif}")].map { |f| File.basename(f) } %>
<% random_image = images.sample %>


<div class="container-lg" >
    <div class="row">
        <div class="col text-center">
            <div class="fw-bold text-center">Gallery</div> 
            <div class= "mx-auto" style="max-width: 100%">            
                <div class="img-fluid"><%= image_tag random_image, class: "d-block mx-auto", 
                style: "height: 500px; width: auto; object-fit: contain;" %></div>  
            </div>    
            <div class="text-center"><%= render "sessions/new"%></div>
        </div> 
</div>


