
<% # Get all jpg and png images from app/assets/images %>
<% images = Dir[Rails.root.join("app/assets/images/*.{jpg,png,jpeg,gif}")].map { |f| File.basename(f) } %>
<% random_image = images.sample %>

<div class="container"> 
    <div class="col align-items-center">
        <div class="font-bold row align-content-center">Gallery</div>
        <div class="w-50"><%= image_tag random_image %></div>
        <div class="row align-content-center"><%= render "sessions/new"%></div>
    </div>
</div>


