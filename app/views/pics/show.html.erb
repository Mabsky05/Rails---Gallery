<div class="container-fluid d-flex align-items-center justify-content-center">
  <div class="row">
    <div class="col">
      <h1 class="text-center text-decoration-underline fw-bold h6"><%= @pic.name %></h1>
    </div>
  <div class="row mx-auto">
    <div class="col auto m-3">
        <% @pic.images.each do |image| %>
        <div><%= image_tag url_for(image),
        class: "img-fluid d-block", 
        style: "height: auto; width: 100%; object-fit: contain" %></div>
        <% end %>
    </div>
  </div>
  <div class="row mx-auto justify-content-center">
      <div class="col-auto">      
          <button type="button" class="btn btn-outline-primary">
            <%=link_to "Replace", edit_pic_path %></div>
          </button>
      <div class="col-auto">
          <button type="button" class="btn btn-outline-danger">
            <%= link_to "Delete", @pic, data: { turbo_method: :delete } %>
          </button>
      </div>
      <div class="col-auto">
          <button type="button" class="btn btn-outline-dark"><%= link_to "Back", pics_path %></button>
      </div>
  </div>
  </div>
</div>