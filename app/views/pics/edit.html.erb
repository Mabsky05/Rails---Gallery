<div class="container text-center">
  <div class="row mb-1 justify-content-center">
    <div class="col">
      <%= form_with model: @pic do |form| %>
      <label for="email" class="form-label">
        <%= form.label :text, "Input new name", for: "pics" %>
        <%= form.text_field :name, class: "form-control" %>
      </label>
    </div>
  </div>
  <div class="row mb-1">
    <div class="col">
      <%= form.label :images, "Upload Images", class: "btn btn-primary" %>
      <%= form.file_field :images, accept: "images/*", class: "hidden-file-input", style: "display: none;" %>
      <%= form.submit "Update", class: "btn btn-primary" %>
    </div>
  </div>
  <div class="row mb-1">
    <div class="col">
      <label class="btn btn-outline-dark fw-bold"> 
      <%= link_to "Go Back", pics_path %>
      <% end %>
      </label>
    </div>
  </div> 
</div>

