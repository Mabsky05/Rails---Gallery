<div class="container text-center">
  <%= form_with model: @pic, multipart: true do |form| %>    
    <div class="row mb-3 justify-content-center">
      <div class="col-md-6">
        <%= form.label :name, "Input new name", class: "form-label" %>
        <%= form.text_field :name, class: "form-control" %>
      </div>
    </div>
    <div class="row mb-3 justify-content-center">
      <div class="col-md-6 d-flex justify-content-center gap-2 align-items-end">
        <div>
          <%= form.label :images, "Upload Images", class: "btn btn-primary" %>
          <%= form.file_field :images, accept: "image/*", class: "hidden-file-input", style: "display: none;" %>
        </div>
        <%= form.submit "Update", class: "btn btn-success" %>
      </div>
    </div>
    <div class="row mb-1 justify-content-center">
      <div class="col-md-6">
        <%= link_to "Go Back", pics_path, class: "btn btn-outline-dark fw-bold" %>
      </div>
    </div> 
  <% end %>
</div>
