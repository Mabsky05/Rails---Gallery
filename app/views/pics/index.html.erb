<div class="container-fluid img-fluid">
  <div class="column">
    <h1 class="font-bold text-4xl">Username index</h1>
    
<div> Partial <%= render "show", pic: @pic %> </div>


<% @pics.each do |pic| %>
<div><%= pic.id %></div>
<div><%= pic.name %></div>
<div><%= pic.updated_at %></div>


<div><%= link_to image_tag url_for(pic), alt: "image placeholder" %></div>
<div><%=link_to "Show", pic_path(pic) %></div>
<% end %>




    </div>

    <h2><%=link_to "New", new_pic_path %></h2>

    <h2><%=link_to "Show", pic_path(@pics) %></h2>

    <h2><%=link_to "Delete", pic_path(:id), method: :delete %></h2>

    <%= button_to "Log out", session_path(:id), method: :delete if authenticated? %>
      </div>
  </div>
</div>

