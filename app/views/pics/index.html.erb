<div class="container">
  <div class="row">
    <div class="col">
      <h1 class="font-bold text-4xl">Photo Gallery</h1>
    </div>
  </div>
  <div class="row">
    <div class="col">
    <% @pics.each do |pic| %>
    </div>
  </div>
  <div class="row align-items-center">
    <div class="col">
          <% if pic.images.attached? %>
            <%= image_tag pic.images.first, style: "max-height:33vh width-auto" %>
          <% else %>
            <div>hoho<%= there is no image %></div>
          <% end %>
    </div>
    <div class="col">
          <div class="text-decoration-underline fw-bold h5"><%= pic.name %></div>
          <div class="text-muted h6"><%= pic.updated_at %></div>
    </div>
    <div class="col">      
          <div><%=link_to "View", pic_path(pic) %></div>
          <div><%=link_to "Edit", pic_path(pic) %></div>
          <div class="text-danger"><%= button_to "Delete", pic_path(pic), method: :delete, data: { turbo_confirm: "Are you sure?" } %></div>
          <% end %>
    </div>
  </div>
  <div class="row">
      <div><%=link_to "Upload New Photo", new_pic_path %></div>
      <div><%= button_to "Log out", session_path(:id), method: :delete if authenticated? %></div>
  </div>
</div>