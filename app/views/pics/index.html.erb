<div class="container">
  <div class="column">
    <h1 class="font-bold text-4xl">Username index</h1>
    <h1>Image Gallery [insert carousel/gallery]
    <% @pics.each do |image| %>
      <% image_tag (image) %>
    <% end %>
    </h1>
    <h2><%=link_to "New", new_pic_path %></h2>

    <h2><%=link_to "View", pic_path(:id) %></h2>

    <h2><%=link_to "Delete", pic_path(:id), method: :delete %></h2>

      <%= button_to "Log out", session_path(:id), method: :delete if authenticated? %>
      </div>
  </div>
</div>