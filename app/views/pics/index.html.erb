<div class="container-fluid img-fluid">
  <div class="column">
    <h1 class="font-bold text-4xl">Welcome</h1>


<% @pics.each do |pic| %>
<div><%= pic.name %></div>
<div><%= pic.updated_at %></div>
<div><%=link_to "View Picture", pic_path(pic) %></div>
<% end %>

    </div>

    <h2><%=link_to "New", new_pic_path %></h2>

    <h2><%=link_to "Show", pic_path(@pics) %></h2>

    <h2><%=link_to "Delete", pic_path(:id), method: :delete %></h2>

    <%= button_to "Log out", session_path(:id), method: :delete if authenticated? %>
      </div>
  </div>
</div>

