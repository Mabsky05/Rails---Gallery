<div class="container">
  <div class="row">
    <div class="col">

      <h1 class="font-bold text-4xl">Welcome</h1>
        <% @pics.each do |pic| %>
        <div><%= pic.name %></div>
        <div>Uploaded at <%= pic.updated_at %></div>
        <div><%=link_to "View", pic_path(pic) %></div>
        <%= button_to "Delete", pic_path(pic), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
        <br>
        <% end %>
   
      <div><%=link_to "New", new_pic_path %></div>
      <div><%=link_to "Show", pic_path(@pics) %></div>
      <div><%=link_to "Delete", pic_path(:id), method: :delete %></div>
      <div><%= button_to "Log out", session_path(:id), method: :delete if authenticated? %></div>
      

    </div>
  </div>
</div>


